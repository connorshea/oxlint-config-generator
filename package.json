{
  "name": "oxlint-config-generator",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate:rules": "tsx scripts/generate-rules.mts",
    "generate:plugins": "tsx scripts/generate-plugins.mts",
    "generate:js-plugins": "tsx scripts/generate-js-plugins.mts",
    "generate:js-plugin-descriptions": "tsx scripts/generate-js-plugin-descriptions.mts",
    "generate:rule-descriptions": "tsx scripts/generate-rule-descriptions.mts",
    "generate:all": "pnpm generate:rules && pnpm generate:plugins && pnpm generate:js-plugins && pnpm generate:js-plugin-descriptions && pnpm generate:rule-descriptions && pnpm fmt"
  },
  "dependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.4.1",
    "@next/eslint-plugin-next": "^16.2.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^9.39.4",
    "eslint-plugin-cypress": "^6.4.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-storybook": "^10.3.6",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-vitest": "^0.5.4",
    "eslint-plugin-vue": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vue-tsc": "^3.2.8"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
